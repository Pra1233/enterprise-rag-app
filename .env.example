# Root environment file for docker-compose.prod.yml (loaded via `--env-file .env`
# and the backend/worker services' `env_file: ../../.env`). Copy this to
# `.env`, fill in real values, and NEVER commit the real file (.gitignore
# already excludes `.env`, `.env.development`, `.env.production`).
#
# Mandatory vs optional is marked per-section below. Anything marked
# mandatory has no safe default and docker-compose.prod.yml will refuse to
# start without it (via the `${VAR:?...}` required-variable syntax).

# ============================================================
# App
# ============================================================
APP_ENV=production
LOG_LEVEL=INFO
API_PREFIX=/api/v1
# Origin the backend's CORS middleware allows — your deployed frontend URL.
FRONTEND_URL=https://your-domain.example.com

# ============================================================
# Auth — MANDATORY. Dev-only HS256 shared secret (see src/api/dependencies.py);
# replace with a real IdP before any real production use. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# ============================================================
# Groq LLM — MANDATORY. Free tier, no credit card: https://console.groq.com
# ============================================================
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ============================================================
# Local embeddings / reranker — optional, these defaults work out of the box
# ============================================================
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
EMBEDDING_DEVICE=cpu

# ============================================================
# PostgreSQL — MANDATORY (both halves must describe the SAME database:
# POSTGRES_USER/PASSWORD/DB bootstrap the postgres container itself;
# POSTGRES_URL is what the backend/worker/migrate containers connect with).
# ============================================================
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=rag_db
POSTGRES_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ============================================================
# Redis — optional (default below matches the compose service name)
# ============================================================
REDIS_URL=redis://redis:6379/0

# ============================================================
# Qdrant — optional (default below matches the compose service name; set
# QDRANT_API_KEY for a managed Qdrant Cloud cluster in production)
# ============================================================
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_rag_chunks

# ============================================================
# MinIO — MANDATORY (both halves must describe the SAME credentials:
# MINIO_ROOT_USER/PASSWORD bootstrap the minio container; MINIO_ACCESS_KEY/
# SECRET_KEY is what the backend/worker connect with — keep them identical).
# ============================================================
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
MINIO_BUCKET=rag-documents

# ============================================================
# Response cache — optional
# ============================================================
CACHE_ENABLED=true
CACHE_TTL=86400

# ============================================================
# LangSmith tracing — optional, free tier (50k traces/month): https://smith.langchain.com
# ============================================================
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-production

# ============================================================
# Evaluation (Phase 6) — optional
# ============================================================
EVALUATION_ENABLED=true
EVALUATION_DATASET_PATH=src/evaluation/datasets/sample_dataset.json
EVALUATION_TOP_K=5
EVALUATION_MAX_CONCURRENCY=2

METRICS_ENABLED=true

# ============================================================
# Celery worker — optional (sane defaults for a small deployment)
# ============================================================
CELERY_CONCURRENCY=2
# Soft limit: task gets a cancellable exception at this many seconds (clean
# stop). Hard limit: task is force-killed shortly after if it hasn't exited.
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_TASK_TIME_LIMIT=300

# ============================================================
# Deployment / image tags — optional
# ============================================================
# Overridden by CI to the release SHA/tag when deploying (see .github/workflows/deploy.yml).
IMAGE_TAG=latest
# Host port nginx publishes. Use 80 for HTTP-only, or front it with the
# HTTPS template (deployment/nginx/default.ssl.conf.template) for 443.
HTTP_PORT=80
# What the FRONTEND calls at runtime (injected into env-config.js — see
# src/config.ts). "/api/v1" (relative) works when nginx proxies /api/ on the
# same origin, which is the default setup here.
PUBLIC_API_BASE_URL=/api/v1
