APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# Dev-only HS256 shared secret for JWT verification (src/api/dependencies.py).
# Replace with a real IdP (RS256 + JWKS) before production.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# Groq (free tier, no credit card — https://console.groq.com)
GROQ_API_KEY=
# llama-3.3-70b-versatile was retired from Groq; openai/gpt-oss-120b is the current
# largest free model. Check https://console.groq.com/docs/models for the live list.
GROQ_MODEL=openai/gpt-oss-120b

# Local embeddings/reranker (no API key needed, run on CPU)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
EMBEDDING_DEVICE=cpu

# Qdrant (docker-compose service locally; a Qdrant Cloud URL + API key in production)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_rag_chunks

# PostgreSQL (docker-compose service)
POSTGRES_URL=postgresql+psycopg2://rag_user:rag_password@localhost:5432/rag_db

# Redis / Celery (docker-compose service)
REDIS_URL=redis://localhost:6379/0

# MinIO (docker-compose service) — original document storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-documents

# Exact-match chat response cache (Redis)
CACHE_ENABLED=true
CACHE_TTL=86400

# LangSmith tracing (free tier, 50k traces/month) — current LangSmith SDK
# env var convention; core/observability.py also sets the older LANGCHAIN_*
# names for compatibility, so you don't need to set those separately.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-production

# Evaluation (Phase 6 — RAGAS + retrieval/answer quality evaluation)
EVALUATION_ENABLED=true
EVALUATION_DATASET_PATH=src/evaluation/datasets/sample_dataset.json
EVALUATION_TOP_K=5
EVALUATION_MAX_CONCURRENCY=2

# Performance/reliability metrics collection
METRICS_ENABLED=true
