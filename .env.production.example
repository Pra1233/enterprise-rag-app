# Production env reference, used by docker-compose.prod.yml. Copy to `.env`
# on the deployment server (NOT into this repo) and fill in every value
# below — there are deliberately no working defaults for anything secret.
#
# Mandatory: JWT_SECRET_KEY, GROQ_API_KEY, POSTGRES_USER, POSTGRES_PASSWORD,
# POSTGRES_URL, MINIO_ROOT_USER, MINIO_ROOT_PASSWORD.
# Everything else has a safe default and may be left as-is.

APP_ENV=production
LOG_LEVEL=INFO
API_PREFIX=/api/v1
# Must be your real deployed frontend origin — the backend's CORS middleware
# only allows this one origin (src/api/main.py).
FRONTEND_URL=https://your-domain.example.com

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
EMBEDDING_DEVICE=cpu

# Generate a strong password, e.g.: openssl rand -base64 24
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=rag_db
POSTGRES_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

REDIS_URL=redis://redis:6379/0

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_rag_chunks

# Generate a strong password, e.g.: openssl rand -base64 24
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
MINIO_BUCKET=rag-documents

CACHE_ENABLED=true
CACHE_TTL=86400

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-production

EVALUATION_ENABLED=true
EVALUATION_DATASET_PATH=src/evaluation/datasets/sample_dataset.json
EVALUATION_TOP_K=5
EVALUATION_MAX_CONCURRENCY=2

METRICS_ENABLED=true

CELERY_CONCURRENCY=2
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_TASK_TIME_LIMIT=300

# Set by CI to the release SHA/tag — leave as `latest` for a manual deploy.
IMAGE_TAG=latest
HTTP_PORT=80
PUBLIC_API_BASE_URL=/api/v1
