# Local development env, used by docker-compose.dev.yml. Copy to
# `.env.development`. Weak/placeholder secrets here are fine — this file is
# only ever used against infra containers on your own machine with all ports
# exposed to localhost (see docker-compose.dev.yml) — never reuse these
# values anywhere reachable from outside your machine.

APP_ENV=development
LOG_LEVEL=DEBUG
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

JWT_SECRET_KEY=dev-only-secret-change-me-but-it-really-does-not-matter-locally
JWT_ALGORITHM=HS256

# Still required — Groq's free tier needs a real key even for local dev.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
EMBEDDING_DEVICE=cpu

POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag_db
POSTGRES_URL=postgresql+psycopg2://rag_user:rag_password@postgres:5432/rag_db

REDIS_URL=redis://redis:6379/0

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=enterprise_rag_chunks

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-documents

CACHE_ENABLED=true
CACHE_TTL=86400

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-development

EVALUATION_ENABLED=true
EVALUATION_DATASET_PATH=src/evaluation/datasets/sample_dataset.json
EVALUATION_TOP_K=5
EVALUATION_MAX_CONCURRENCY=2

METRICS_ENABLED=true
